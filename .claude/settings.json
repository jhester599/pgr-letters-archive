{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git merge*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git stash*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git config*)",
      "Bash(ls*)",
      "Bash(find . *)",
      "Bash(python3 scripts/*)",
      "Bash(python scripts/*)",
      "Bash(python3 -c *)",
      "Bash(python -m json.tool*)",
      "Bash(wc *)",
      "Bash(base64 *)",
      "Bash(mkdir -p *)",
      "Bash(cat .git/*)",
      "Bash(cat .github/*)"
    ]
  }
}
